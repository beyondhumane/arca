[Desktop Entry]
# Dolphin service menu (KDE Frameworks 5.85 and later, Plasma 6), installed to
# /usr/share/kio/servicemenus. Same archive types as arca.desktop; arca-setup's
# tests keep the two lists in step.
Type=Service
Icon=dev.beyondhumane.Arca
MimeType=application/zip;application/x-7z-compressed;application/x-tar;application/x-compressed-tar;application/gzip;application/x-gzip;application/x-xz-compressed-tar;application/x-xz;application/x-bzip2-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip1-compressed-tar;application/x-bzip2;application/x-bzip;application/x-zstd-compressed-tar;application/zstd;application/vnd.rar;application/x-rar;application/x-cd-image;application/vnd.efi.iso;application/x-cpio;application/vnd.ms-cab-compressed;application/x-lha;application/x-lzh-compressed;
Actions=extractHere;extractToFolder;
X-KDE-Submenu=Arca

[Desktop Action extractHere]
Name=Extract here
Name[es]=Extraer aquí
Name[uk]=Видобути сюди
Icon=dev.beyondhumane.Arca
Exec=arca-gui --extract-here %F

[Desktop Action extractToFolder]
Name=Extract to a new folder
Name[es]=Extraer en una carpeta nueva
Name[uk]=Видобути в нову папку
Icon=dev.beyondhumane.Arca
Exec=arca-gui --extract-to-folder %F
